# Database (Neon / Vercel Marketplace)
# Runtime connection (pooled URL recommended on Vercel).
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Optional direct/unpooled URL used by Drizzle migrations.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/db?sslmode=require"
# Local-only alternative after `npm run db:local:init`:
# DATABASE_URL="postgresql://postgres@localhost:5433/leadm"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Clerk webhook (svix)
CLERK_WEBHOOK_SECRET="whsec_xxx"

# The single admin account. Must match the verified Clerk email.
ADMIN_EMAIL="admin@example.com"

# Protects /api/cron/daily
CRON_SECRET="change-me"

# App time zone used for day boundaries
APP_TIMEZONE="Asia/Karachi"

# Optional: never enable in production. No demo clients are bundled by default.
# SEED_SAMPLE_DATA="false"
